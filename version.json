{
  "name": "CloudStatus Pure Pages",
  "version": "100.0.0",
  "ui_language": "zh-TW",
  "architecture": "native-es-modules-plus-service-plugin-registry",
  "build_tool_required": false,
  "bundled_cname": false,
  "service_count": 24,
  "service_registry": "assets/services/registry.js",
  "service_module_directory": "assets/services/",
  "core_module_directory": "assets/core/",
  "parser_module_directory": "assets/parsers/",
  "ui_module_directory": "assets/ui/",
  "style_module_directory": "assets/styles/",
  "bootstrap": "assets/app.js",
  "css_manifest": "assets/style.css",
  "current_state_and_history_independent": true,
  "status_inference": false,
  "event_status_inference": false,
  "active_recent_separate": true,
  "max_recent_events_per_card": 3,
  "event_language": "source-original",
  "source_priority": [
    "official-api",
    "official-json",
    "official-rss",
    "official-history",
    "official-status",
    "official-announcement",
    "official-backup",
    "trusted-third-party",
    "other-backup",
    "official-page-entry"
  ],
  "frontend_refresh_minutes": 5,
  "foreground_refresh_threshold_minutes": 2,
  "cache_key": "cloudstatus-cache-v100",
  "cache_fresh_minutes": 15,
  "cache_stale_hours": 24,
  "responsive_layout": "single-column-under-760px / natural-flow-two-columns-at-760px-plus",
  "desktop_layout": "two independent normal-flow columns",
  "telegram": {
    "service_module": "assets/services/telegram-dc.js",
    "browser_dc_measurement": "official WebSocket endpoint reachability",
    "global_probe_script": "scripts/telegram-global-probe.mjs",
    "global_probe_data": "data/telegram-global.json",
    "global_probe_provider": "Check-Host machine nodes",
    "global_probe_measurement": "TCP/443",
    "global_probe_schedule": "07,22,37,52 minutes each hour",
    "global_probe_interval_minutes": 15,
    "rate_limit_429_is_telegram_outage": false,
    "regions": [
      "亞洲",
      "歐洲",
      "北美",
      "南美",
      "大洋洲",
      "非洲"
    ],
    "dc_physical_regions": {
      "DC1": "Miami / North America",
      "DC2": "Amsterdam / Europe",
      "DC3": "Miami / North America",
      "DC4": "Amsterdam / Europe",
      "DC5": "Singapore / Asia"
    }
  },
  "dmit": {
    "primary_status_source": "https://does.dmit.fail/api/v1/status",
    "services_source": "https://does.dmit.fail/api/v1/services",
    "incidents_source": "https://does.dmit.fail/api/v1/incidents",
    "fallbacks": [],
    "security_response_source_enabled": false,
    "api_docs": "https://does.dmit.fail/api-docs",
    "compact_status_fallback": "https://does.dmit.fail/status.json",
    "source_label": "API · DOES DMIT FAIL?",
    "public_api_key_required": false,
    "documented_rate_limit_per_minute": 60,
    "mode": "api-only",
    "server_status_reader_enabled": false,
    "telegram_reader_enabled": false,
    "section_links": {
      "目前事件": "https://does.dmit.fail/",
      "最近事件": "https://does.dmit.fail/incidents",
      "服務": "https://does.dmit.fail/services"
    },
    "services_ui": "location-cards -> product-lines -> service-items",
    "services_page": "https://does.dmit.fail/services",
    "services_locations_ui": [
      "洛杉磯",
      "東京",
      "香港",
      "應用"
    ],
    "services_primary_source": "https://does.dmit.fail/services",
    "services_primary_transport": "Reader",
    "services_api_fallback": "https://does.dmit.fail/api/v1/services?locale=en",
    "card_order": [
      "health",
      "目前事件",
      "最近 3 筆事件",
      "no-event message",
      "服務"
    ],
    "recent_history_display_limit": 3,
    "services_deployment_generator": "scripts/dmit-services.mjs",
    "services_deployment_data": "data/dmit-services.json",
    "services_runtime_priority": [
      "same-origin data/dmit-services.json",
      "direct /api/v1/services",
      "Reader /services"
    ],
    "services_seed_count": 37
  },
  "github_pages": {
    "workflow": ".github/workflows/pages.yml",
    "workflow_name": "CloudStatus Deploy + Telegram Probe",
    "pages_source": "GitHub Actions",
    "actions_required_for_pages_workflow": true,
    "actions_required_for_browser_only_status_sources": false,
    "actions_required_for_telegram_global_probe": true
  },
  "docs": [
    "README.md",
    "ARCHITECTURE.md",
    "DEPLOYMENT.md",
    "CHANGELOG.md"
  ],
  "synchronized_asset_version": "100.0.0",
  "asset_cache_busting": {
    "html_entry_assets": true,
    "service_plugin_loader": true,
    "all_es_module_imports": true,
    "all_css_imports": true,
    "reason": "Prevent stale transitive modules/styles after modularization"
  }
}
